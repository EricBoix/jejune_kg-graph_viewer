FROM node:20-slim AS builder
WORKDIR /build
COPY package*.json ./
RUN npm ci
COPY . .
ARG DOCS_SERVER_URL
ARG MARKDOWN_TRIGGER_URL
ARG MARKDOWN_BROWSER_URL
ENV VITE_DOCS_SERVER_URL=$DOCS_SERVER_URL \
    VITE_MARKDOWN_TRIGGER_URL=$MARKDOWN_TRIGGER_URL \
    VITE_MARKDOWN_BROWSER_URL=$MARKDOWN_BROWSER_URL
RUN npm run build

FROM nginx:alpine
COPY --from=builder /build/dist /usr/share/nginx/html
