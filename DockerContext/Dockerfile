FROM node:20-slim AS builder
WORKDIR /build
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_DOCS_SERVER_URL
ARG VITE_MARKDOWN_TRIGGER_URL
ARG VITE_MARKDOWN_BROWSER_URL
ENV VITE_DOCS_SERVER_URL=$VITE_DOCS_SERVER_URL
ENV VITE_MARKDOWN_TRIGGER_URL=$VITE_MARKDOWN_TRIGGER_URL
ENV VITE_MARKDOWN_BROWSER_URL=$VITE_MARKDOWN_BROWSER_URL
RUN npm run build

FROM nginx:alpine
COPY --from=builder /build/dist /usr/share/nginx/html
